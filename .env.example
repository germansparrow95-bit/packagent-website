# Local development uses a zero-config SQLite-compatible libSQL file.
DATABASE_URL=file:data/packagent.db

# Set this for a remote Turso/libSQL database. Leave empty for a local file.
DATABASE_AUTH_TOKEN=

# At least 16 characters. Never expose this value to the browser.
ADMIN_TOKEN=replace-with-a-long-random-token

# Used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
